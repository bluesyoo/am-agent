<?xml version="1.0" encoding="UTF-8"?>
<Configuration status="WARN" monitorInterval="30">
  <Appenders>
    <Console name="consoleAppender" target="SYSTEM_OUT">
      <PatternLayout>
        <Pattern>%d{MM-dd HH:mm:ss} [%-5level] %logger{0}.%M:%L # %msg%n</Pattern>
      </PatternLayout>
    </Console>
  </Appenders>

  <Loggers>
    <Logger name="org.apache.kafka.clients" level="WARN" additivity="false"/>
    <Logger name="org.springframework.kafka" level="WARN" additivity="false"/>
    <Logger name="org.apache.kafka.common.utils.AppInfoParser" level="ERROR" additivity="false"/>

    <!-- 필요 시 Hibernate SQL 로그 활성화 -->
    <!--
    <Logger name="org.hibernate" level="info" additivity="false">
      <AppenderRef ref="consoleAppender"/>
    </Logger>
    <Logger name="org.hibernate.SQL" level="debug" additivity="false">
      <AppenderRef ref="consoleAppender"/>
    </Logger>
    <Logger name="org.hibernate.type.descriptor.sql" level="trace" additivity="false">
      <AppenderRef ref="consoleAppender"/>
    </Logger>
    -->

    <Root level="INFO">
      <AppenderRef ref="consoleAppender"/>
    </Root>
  </Loggers>
</Configuration>
